---
import "../styles/global.css";
import Icon from "./Icon.astro";
import Downloads from "./Downloads.astro";
import Flag from "./Flag.astro";
import { AGENTS } from "../lib/icons";
import { dictionaries, localePath, otherLocale, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dictionaries[locale];
const lang = locale === "en" ? "en" : "pt";
const other = dictionaries[otherLocale(locale)];

const REPO = "https://github.com/LucasCavalheri/huskmap";
const INSTALL = "curl -fsSL https://huskmap.lucascavalheri.com.br/install.sh | bash";
const abs = (path: string) => new URL(path, Astro.site).href;
const canonical = abs(localePath(locale));

const shot = (shade: "dark" | "light") => ({
  src: `/shots/map-${lang}-${shade}-1480.webp`,
  srcset: `/shots/map-${lang}-${shade}-1480.webp 1480w, /shots/map-${lang}-${shade}-2960.webp 2960w`,
});

// A few quiet blips for the background sonar: [angle°, radius 0..1, tone]
const blips: [number, number, string][] = [
  [28, 0.62, "moss"],
  [74, 0.84, "moss"],
  [118, 0.46, "rust"],
  [161, 0.9, "moss"],
  [212, 0.7, "amber"],
  [256, 0.38, "moss"],
  [301, 0.78, "rust"],
  [338, 0.55, "amber"],
];
const at = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return { x: +(500 * r * Math.sin(a)).toFixed(1), y: +(-500 * r * Math.cos(a)).toFixed(1) };
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "huskmap",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux",
  description: t.meta.description,
  url: canonical,
  image: abs("/og.png"),
  license: "https://opensource.org/licenses/MIT",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  downloadUrl: `${REPO}/releases/latest`,
  codeRepository: REPO,
  inLanguage: t.htmlLang,
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={abs(localePath("en"))} />
    <link rel="alternate" hreflang="pt-BR" href={abs(localePath("pt-BR"))} />
    <link rel="alternate" hreflang="x-default" href={abs(localePath("en"))} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="huskmap" />
    <meta property="og:title" content={t.meta.ogTitle} />
    <meta property="og:description" content={t.meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:image" content={abs("/og.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.ogTitle} />
    <meta name="twitter:description" content={t.meta.ogDescription} />
    <meta name="twitter:image" content={abs("/og.png")} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/InstrumentSerif-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Theme before first paint: saved pick, else the system's. No flash.
      (() => {
        const d = document.documentElement;
        d.classList.add("js");
        let t = null;
        try { t = localStorage.getItem("huskmap-theme"); } catch {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        d.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.hero.skip}</a>

    <header class="top" data-top>
      <div class="wrap">
        <a class="brand" href={localePath(locale)} aria-label={t.nav.home}>
          <img src="/icon.svg" alt="" width="26" height="26" />
          huskmap
        </a>
        <nav class="links" aria-label={t.nav.label}>
          <a class="nav-gh" href={REPO}><Icon name="github" brand="GitHub" /> {t.nav.github}</a>
          <button class="theme" type="button" data-theme-toggle aria-label={t.nav.theme} title={t.nav.theme}>
            <Icon name="sun" class="sun" />
            <Icon name="moon" class="moon" />
          </button>
          <span class="langs" role="group" aria-label={t.nav.language}>
            {(["en", "pt-BR"] as const).map((l) => {
              const here = l === locale;
              const dict = dictionaries[l];
              return (
                <a
                  href={localePath(l)}
                  hreflang={dict.htmlLang}
                  lang={dict.htmlLang}
                  class:list={["lang", { here }]}
                  aria-current={here ? "page" : undefined}
                  aria-label={`${dict.short} · ${dict.label}`}
                >
                  <Flag country={l === "en" ? "us" : "br"} />
                  <span>{dict.short}</span>
                </a>
              );
            })}
          </span>
          <a class="btn" href="#install"><Icon name="download" /> {t.nav.install}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <svg class="sonar" viewBox="-520 -520 1040 1040" aria-hidden="true">
          {[0.25, 0.5, 0.75, 1].map((r) => <circle r={500 * r} />)}
          <line x1="-500" y1="0" x2="500" y2="0" />
          <line x1="0" y1="-500" x2="0" y2="500" />
          <g class="beam"><path d="M0 0 L0 -500 A500 500 0 0 0 -104 -489 Z" /></g>
          {blips.map(([deg, r, tone]) => {
            const p = at(deg, r);
            return <circle class={`blip ${tone}`} cx={p.x} cy={p.y} r="5" style={`--d:${(deg / 360) * 10}s`} />;
          })}
        </svg>
        <div class="wrap hero-inner">
          <span class="pill rise" style="--d:0s"><Icon name="terminal" /> {t.hero.eyebrow}</span>
          <h1 class="display rise" style="--d:.08s">
            {t.hero.titleA}<br /><em>{t.hero.titleB}</em>
          </h1>
          <p class="lead rise" style="--d:.2s">{t.hero.lead}</p>
          <div class="actions rise" style="--d:.32s">
            <div class="cmd">
              <code><span class="prompt">$</span> {INSTALL}</code>
              <button class="copy" type="button" data-copy={INSTALL} data-done={t.hero.copied} aria-label={t.hero.copy}>
                <span class="copy-icons"><Icon name="copy" class="i-copy" /><Icon name="check" class="i-check" /></span>
                <span data-copy-label>{t.hero.copy}</span>
              </button>
            </div>
            <a class="text-link" href={REPO}><Icon name="github" brand="GitHub" /> {t.hero.github} <Icon name="arrow-right" /></a>
          </div>
        </div>
      </section>

      <section class="product">
        <div class="wrap">
          <figure class="compare-wrap reveal">
            <div class="compare" data-compare>
              <img {...shot("dark")} sizes="(max-width: 1120px) 100vw, 1080px" width="1480" height="920" alt={t.compare.alt.dark} fetchpriority="high" decoding="async" />
              <img class="light-shot" {...shot("light")} sizes="(max-width: 1120px) 100vw, 1080px" width="1480" height="920" alt={t.compare.alt.light} decoding="async" />
              <span class="handle" aria-hidden="true"></span>
              <input type="range" min="0" max="100" value="50" aria-label={t.compare.drag} />
            </div>
            <figcaption>
              <span><Icon name="moon" /> {t.compare.dark}</span>
              {t.compare.caption}
              <span>{t.compare.light} <Icon name="sun" /></span>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="points">
        <div class="wrap">
          <ul>
            {t.points.map((p, i) => (
              <li class="reveal" style={`--delay:${i * 0.08}s`}>
                <Icon name={p.icon} />
                <h2>{p.name}</h2>
                <p>{p.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="agents reveal" aria-label={t.agents}>
        <p>{t.agents}</p>
        <div class="marks">
          {AGENTS.map((m) => <Icon name={m.mark} brand={m.name} />)}
        </div>
      </section>

      <section class="install" id="install">
        <div class="wrap reveal">
          <h2 class="display">{t.install.title}</h2>
          <div class="cmd">
            <code><span class="prompt">$</span> {INSTALL}</code>
            <button class="copy" type="button" data-copy={INSTALL} data-done={t.hero.copied} aria-label={t.hero.copy}>
                <span class="copy-icons"><Icon name="copy" class="i-copy" /><Icon name="check" class="i-check" /></span>
                <span data-copy-label>{t.hero.copy}</span>
              </button>
          </div>
          <p>
            <Icon name="shield" /> {t.install.note} <a href="#download">{t.install.releases} <Icon name="download" /></a>
          </p>
        </div>
      </section>

      <Downloads t={t} locale={t.htmlLang} />
    </main>

    <footer class="foot">
      <div class="wrap">
        <span class="brand small"><img src="/icon.svg" alt="" width="18" height="18" /> huskmap</span>
        <nav aria-label="Footer">
          <a href={REPO}><Icon name="github" brand="GitHub" /> GitHub</a>
          <a href={`${REPO}/releases`}><Icon name="tag" /> {t.footer.releases}</a>
          <a href={`${REPO}/blob/main/LICENSE`}><Icon name="license" /> {t.footer.license}</a>
          <a href={localePath(otherLocale(locale))} hreflang={other.htmlLang}><Icon name="language" /> {t.nav.other}</a>
        </nav>
        <small>{t.footer.marks}</small>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const root = document.documentElement;

        // ---- theme: a circle of the new palette opens from the switch ----
        const toggle = document.querySelector("[data-theme-toggle]");
        const paint = (theme) => {
          root.dataset.theme = theme;
          try { localStorage.setItem("huskmap-theme", theme); } catch {}
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.content = theme === "dark" ? "#0e0d0b" : "#f6f3ec";
        };
        toggle && toggle.addEventListener("click", () => {
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          if (still) return paint(next);
          if (!document.startViewTransition) {
            root.classList.add("theme-fade");
            paint(next);
            setTimeout(() => root.classList.remove("theme-fade"), 500);
            return;
          }
          const r = toggle.getBoundingClientRect();
          const x = r.left + r.width / 2;
          const y = r.top + r.height / 2;
          const end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          document.startViewTransition(() => paint(next)).ready.then(() => {
            root.animate(
              { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${end}px at ${x}px ${y}px)`] },
              { duration: 720, easing: "cubic-bezier(.22,.8,.2,1)", pseudoElement: "::view-transition-new(root)" },
            );
          });
        });

        // ---- language: stay in place, let the letters turn into the other language ----
        const GLYPHS = "abcdefghijklmnopqrstuvwxyzáãçéêíóôõú";
        const textNodes = (body) => {
          const out = [];
          const walk = document.createTreeWalker(body, NodeFilter.SHOW_TEXT, {
            acceptNode: (n) =>
              !n.nodeValue.trim() || n.parentElement.closest("script,style,svg")
                ? NodeFilter.FILTER_REJECT
                : NodeFilter.FILTER_ACCEPT,
          });
          while (walk.nextNode()) out.push(walk.currentNode);
          return out;
        };
        const scramble = (node, to, delay) =>
          new Promise((done) => {
            const from = node.nodeValue;
            const len = Math.max(from.length, to.length);
            const time = Math.min(700, 260 + len * 7);
            const t0 = performance.now() + delay;
            const frame = (now) => {
              const k = Math.max(0, Math.min(1, (now - t0) / time));
              let s = "";
              for (let i = 0; i < len; i++) {
                const at = i / len;
                const c = to[i] ?? "";
                if (k >= at * 0.6 + 0.4) s += c;
                else if (k > at * 0.6) s += c === " " || c === "" ? c : GLYPHS[(Math.random() * GLYPHS.length) | 0];
                else s += from[i] ?? "";
              }
              node.nodeValue = s;
              if (k < 1) requestAnimationFrame(frame);
              else {
                node.nodeValue = to;
                done();
              }
            };
            requestAnimationFrame(frame);
          });
        const ATTRS = ["alt", "aria-label", "title", "srcset", "src", "data-done", "aria-current", "href", "hreflang"];
        let busy = false;
        const switchLang = async (href, push) => {
          if (busy) return;
          busy = true;
          try {
            const res = await fetch(href, { headers: { Accept: "text/html" } });
            if (!res.ok) throw new Error(String(res.status));
            const next = new DOMParser().parseFromString(await res.text(), "text/html");
            const oldEls = [...document.body.querySelectorAll("*")];
            const newEls = [...next.body.querySelectorAll("*")];
            const oldText = textNodes(document.body);
            const newText = textNodes(next.body);
            if (oldEls.length !== newEls.length || oldText.length !== newText.length) throw new Error("layout differs");
            oldEls.forEach((el, i) => {
              const src = newEls[i];
              for (const a of ATTRS) {
                const v = src.getAttribute(a);
                if (v === null) el.removeAttribute(a);
                else if (el.getAttribute(a) !== v) el.setAttribute(a, v);
              }
              if (el.classList.contains("lang")) el.classList.toggle("here", src.classList.contains("here"));
            });
            root.lang = next.documentElement.lang;
            document.title = next.title;
            for (const sel of ['meta[name="description"]', 'link[rel="canonical"]']) {
              const a = document.head.querySelector(sel);
              const b = next.head.querySelector(sel);
              if (a && b) a.replaceWith(b.cloneNode(true));
            }
            if (push) history.pushState({ lang: root.lang }, "", href);
            // Hold what you are looking at in place while texts above it change length.
            const probe = document.elementFromPoint(innerWidth / 2, innerHeight * 0.4);
            const anchor = (probe && probe.closest("h1,h2,h3,p,li,figure,section")) || null;
            const top0 = anchor ? anchor.getBoundingClientRect().top : 0;
            let holding = !!anchor && scrollY > 0;
            const hold = () => {
              if (!holding) return;
              const drift = anchor.getBoundingClientRect().top - top0;
              if (Math.abs(drift) > 0.5) scrollBy({ top: drift, behavior: "instant" });
              requestAnimationFrame(hold);
            };
            requestAnimationFrame(hold);
            const jobs = [];
            let n = 0;
            oldText.forEach((node, i) => {
              const to = newText[i].nodeValue;
              if (node.nodeValue === to) return;
              if (still) node.nodeValue = to;
              else jobs.push(scramble(node, to, Math.min(n++ * 14, 360)));
            });
            await Promise.all(jobs);
            await new Promise((r) => requestAnimationFrame(r));
            holding = false;
          } catch {
            location.href = href;
          } finally {
            busy = false;
          }
        };
        document.addEventListener("click", (e) => {
          const a = e.target.closest("a[hreflang]");
          if (!a || e.metaKey || e.ctrlKey || e.shiftKey || a.getAttribute("aria-current") === "page") return;
          const url = new URL(a.href, location.href);
          if (url.origin !== location.origin) return;
          e.preventDefault();
          switchLang(url.pathname, true);
        });
        addEventListener("popstate", () => switchLang(location.pathname, false));
        const top = document.querySelector("[data-top]");
        const onScroll = () => top && top.classList.toggle("scrolled", scrollY > 16);
        addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        const compare = document.querySelector("[data-compare]");
        const range = compare && compare.querySelector("input");
        const set = (v) => compare.style.setProperty("--split", v + "%");
        let touched = false;
        range &&
          range.addEventListener("input", () => {
            touched = true;
            set(range.value);
          });
        // First look: the split glides once so both themes show themselves.
        const glide = () => {
          if (still || touched) return;
          const t0 = performance.now();
          const tick = (now) => {
            if (touched) return;
            const k = Math.min(1, (now - t0) / 2400);
            const v = 50 + 30 * Math.sin(k * Math.PI * 2) * (1 - k);
            set(v.toFixed(2));
            range.value = String(Math.round(v));
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("in");
              if (e.target.contains(compare)) setTimeout(glide, 450);
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -10% 0px" },
        );
        document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

        document.querySelectorAll("[data-copy]").forEach((btn) => {
          const label = btn.querySelector("[data-copy-label]");
          btn.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(btn.dataset.copy);
              const idle = label.textContent;
              label.textContent = btn.dataset.done;
              btn.classList.add("done");
              setTimeout(() => {
                label.textContent = idle;
                btn.classList.remove("done");
              }, 1800);
            } catch {}
          });
        });
      })();
    </script>
  </body>
</html>
