---
// National flags for the language switch, drawn to their official proportions (US 19:10,
// Brazil 10:7) and simplified only where a 24 px flag cannot show detail. They wave gently:
// a small 3D flutter plus a sheen running across the cloth. Motion stops with reduced motion.
interface Props {
  country: "us" | "br";
}
const { country } = Astro.props;
const stripes = Array.from({ length: 13 }, (_, i) => i);
const stars: [number, number][] = [];
for (let r = 0; r < 9; r++) {
  const cols = r % 2 === 0 ? 6 : 5;
  for (let c = 0; c < cols; c++) {
    stars.push([(r % 2 === 0 ? 1.27 : 2.53) + c * 2.53, 0.54 + r * 1.08]);
  }
}
const brStars: [number, number, number][] = [
  [8.2, 7.9, 0.28], [9.1, 8.6, 0.22], [10.2, 8.2, 0.26], [11.3, 8.9, 0.2], [10.6, 9.6, 0.24],
  [9.4, 9.5, 0.18], [11.9, 7.9, 0.18], [8.8, 6.3, 0.16],
];
---

<span class={`flag flag-${country}`} aria-hidden="true">
  {country === "us" ? (
    <svg viewBox="0 0 38 20" preserveAspectRatio="none">
      {stripes.map((i) => (
        <rect y={(i * 20) / 13} width="38" height={20 / 13 + 0.02} fill={i % 2 === 0 ? "#b22234" : "#ffffff"} />
      ))}
      <rect width="15.2" height={(7 * 20) / 13} fill="#3c3b6e" />
      {stars.map(([x, y]) => <circle cx={x} cy={y} r="0.34" fill="#ffffff" />)}
    </svg>
  ) : (
    <svg viewBox="0 0 20 14" preserveAspectRatio="none">
      <rect width="20" height="14" fill="#009c3b" />
      <path d="M1.7 7 L10 1.2 L18.3 7 L10 12.8 Z" fill="#ffdf00" />
      <circle cx="10" cy="7" r="3.5" fill="#002776" />
      <path d="M6.62 6.1 Q10 5.2 13.42 7.55 L13.3 8.05 Q10 5.8 6.55 6.7 Z" fill="#ffffff" />
      {brStars.map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#ffffff" />)}
    </svg>
  )}
</span>

<style>
  .flag {
    position: relative;
    display: inline-block;
    width: 22px;
    height: 15px;
    border-radius: 3px;
    overflow: hidden;
    flex: none;
    box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.18), 0 2px 4px -1px rgba(40, 30, 20, 0.35);
    transform-origin: 0 50%;
    animation: flutter 3.2s ease-in-out infinite;
    will-change: transform;
  }
  .flag-br {
    animation-delay: -1.6s;
  }
  .flag svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Cloth: light and shadow folding across as it waves. */
  .flag::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(0, 0, 0, 0.18) 0%,
      rgba(255, 255, 255, 0.28) 22%,
      rgba(0, 0, 0, 0.12) 44%,
      rgba(255, 255, 255, 0.22) 66%,
      rgba(0, 0, 0, 0.16) 88%
    );
    background-size: 220% 100%;
    mix-blend-mode: soft-light;
    animation: sheen 3.2s linear infinite;
    animation-delay: inherit;
  }
  @keyframes flutter {
    0%, 100% { transform: perspective(60px) rotateY(0deg) skewY(0deg); }
    25% { transform: perspective(60px) rotateY(-14deg) skewY(-2deg); }
    50% { transform: perspective(60px) rotateY(0deg) skewY(1deg); }
    75% { transform: perspective(60px) rotateY(12deg) skewY(2deg); }
  }
  @keyframes sheen {
    from { background-position: 110% 0; }
    to { background-position: -110% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flag,
    .flag::after {
      animation: none;
    }
  }
</style>
