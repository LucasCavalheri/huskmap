---
// Direct downloads for every Linux, resolved from the latest GitHub release at build time.
// The processor switch is pure CSS (radio inputs); a tiny script only preselects ARM64 when
// the browser says so.
import Icon from "./Icon.astro";
import { distro } from "../lib/icons";
import { ARCHES, FAMILIES, REPO_URL, formatSize } from "../data/release.mjs";
import { downloads } from "../data/downloads";
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
  locale: string;
}
const { t, locale } = Astro.props;
const d = t.download;
const marks = (names: string[]) => names.map((n) => distro(n)).join("");
---

<section class="downloads" id="download">
  <div class="wrap">
    <div class="dl-head reveal">
      <h2 class="display">{d.title}</h2>
      <p>{d.lead}</p>
    </div>

    <div class="dl-board reveal">
      {ARCHES.map((arch, i) => <input type="radio" name="arch" id={`arch-${arch}`} value={arch} checked={i === 0} />)}
      <div class="arch" role="radiogroup" aria-label={d.archLabel}>
        {ARCHES.map((arch) => <label for={`arch-${arch}`}>{d.arch[arch as keyof typeof d.arch]}</label>)}
      </div>

      {ARCHES.map((arch) => (
        <ul class={`dl-set set-${arch}`}>
          {FAMILIES.map((f) => {
            const file = downloads?.files[arch]?.[f.id] ?? null;
            const body = (
              <>
                <span class="dl-marks" set:html={marks(f.marks)} />
                <span class="dl-ext">{f.ext}</span>
                <span class="dl-who">{d.families[f.id as keyof typeof d.families]}</span>
                <span class="dl-meta">
                  {file ? (
                    <>
                      <span>{formatSize(file.size, locale)}</span>
                      <span class="dl-get">{d.get} <Icon name="arrow-right" /></span>
                    </>
                  ) : (
                    <span>{downloads ? d.unavailable : d.soonShort}</span>
                  )}
                </span>
              </>
            );
            return (
              <li>
                {file ? (
                  <a class="dl-card" href={file.url} download title={file.name}>
                    {body}
                  </a>
                ) : (
                  <div class="dl-card off" aria-disabled="true">
                    {body}
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      ))}

      <p class="dl-foot">
        {downloads ? (
          <>
            {d.version.replace("{v}", downloads.version)} ·{" "}
            {downloads.sums && <a href={downloads.sums}>{d.sums}</a>}
            {downloads.sums && " · "}
            <a href={downloads.page}>{d.notes}</a>
          </>
        ) : (
          <>
            {d.soon} <a href={REPO_URL}>GitHub</a>
          </>
        )}
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (async () => {
    const arm = document.getElementById("arch-aarch64");
    if (!arm) return;
    try {
      const hints = navigator.userAgentData && (await navigator.userAgentData.getHighEntropyValues(["architecture"]));
      if ((hints && hints.architecture === "arm") || /aarch64|arm64/i.test(navigator.userAgent)) arm.checked = true;
    } catch {}
  })();
</script>

<style>
  .downloads {
    padding: 100px 0 120px;
    border-top: 1px solid var(--line);
  }
  .dl-head {
    text-align: center;
    margin-bottom: 36px;
  }
  .dl-head h2 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
  }
  .dl-head p {
    margin: 14px auto 0;
    max-width: 30em;
    color: var(--soft);
  }
  .dl-board > input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .arch {
    display: flex;
    width: fit-content;
    margin: 0 auto 28px;
    padding: 4px;
    gap: 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--raised);
  }
  .arch label {
    padding: 8px 18px;
    border-radius: 999px;
    font-size: 14.5px;
    color: var(--soft);
    cursor: pointer;
    transition: background 0.25s, color 0.25s;
  }
  #arch-x86_64:checked ~ .arch label[for="arch-x86_64"],
  #arch-aarch64:checked ~ .arch label[for="arch-aarch64"] {
    background: var(--ink);
    color: var(--paper);
  }
  #arch-x86_64:focus-visible ~ .arch label[for="arch-x86_64"],
  #arch-aarch64:focus-visible ~ .arch label[for="arch-aarch64"] {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .dl-set {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }
  #arch-x86_64:checked ~ .set-x86_64,
  #arch-aarch64:checked ~ .set-aarch64 {
    display: grid;
    animation: swap 0.45s var(--ease);
  }
  @keyframes swap {
    from { opacity: 0; transform: translateY(6px); }
  }
  .dl-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 20px 18px 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--raised);
    transition: border-color 0.25s, transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  a.dl-card:hover {
    border-color: var(--ink);
    transform: translateY(-3px);
    box-shadow: 0 18px 36px -24px rgba(40, 30, 20, 0.45);
  }
  .dl-card.off {
    opacity: 0.55;
  }
  .dl-marks {
    display: flex;
    gap: 8px;
    color: var(--soft);
    margin-bottom: 22px;
  }
  .dl-marks :global(svg) {
    width: 20px;
    height: 20px;
  }
  .dl-ext {
    font: 400 26px/1 var(--serif);
  }
  .dl-who {
    margin-top: 6px;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--soft);
    flex: 1;
  }
  .dl-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font: 400 12px/1 var(--mono);
    color: var(--faint);
  }
  .dl-get {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
  }
  a.dl-card:hover .dl-get :global(.icon) {
    transform: translateX(2px);
  }
  .dl-get :global(.icon) {
    transition: transform 0.25s var(--ease);
  }
  .dl-foot {
    margin: 24px 0 0;
    text-align: center;
    font-size: 14px;
    color: var(--faint);
  }
  .dl-foot a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 4px;
  }
  @media (max-width: 900px) {
    .dl-set {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .dl-set {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .dl-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "ext ext meta" "who who meta";
      align-items: center;
      gap: 2px 12px;
      padding: 14px 16px;
    }
    .dl-marks {
      display: none;
    }
    .dl-ext {
      grid-area: ext;
      font-size: 22px;
    }
    .dl-who {
      grid-area: who;
      margin: 0;
    }
    .dl-meta {
      grid-area: meta;
      flex-direction: column;
      align-items: end;
      margin: 0;
      padding: 0;
      border: 0;
      gap: 6px;
    }
  }
</style>
