[Desktop Entry]
Type=Application
Version=1.5
Name=huskmap
GenericName=Agent Leftovers Map
GenericName[pt_BR]=Mapa das Sobras dos Agentes
Comment=See what AI coding agents left on your disk and free the space safely
Comment[pt_BR]=Veja o que os agentes de IA deixaram no seu disco e libere o espaço com segurança
Exec=huskmap gui
TryExec=huskmap
Icon=huskmap
Terminal=false
Categories=Development;RevisionControl;
Keywords=git;worktree;agents;claude;codex;cursor;node_modules;cache;disk;space;trash;
StartupNotify=true
StartupWMClass=lucas.cavalheri.huskmap
